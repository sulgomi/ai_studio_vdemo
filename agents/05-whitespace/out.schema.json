{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/whitespace/out.schema.json",
  "title": "whitespace result",
  "type": "object",
  "required": ["picks"],
  "additionalProperties": false,
  "properties": {
    "picks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["rank", "seg", "need", "engine_rank", "rationale", "evidence_ids", "deviates_from_engine", "risk", "origin"],
        "additionalProperties": false,
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 3},
          "seg": {"type": "string"},
          "need": {"type": "string"},
          "engine_rank": {"type": "integer", "minimum": 1},
          "rationale": {"type": "string", "minLength": 20},
          "evidence_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^(T[0-9]+|tag:[a-z_]+|need:[a-z_]+)$"}},
          "deviates_from_engine": {"type": "boolean"},
          "deviation_reason": {"type": ["string", "null"]},
          "risk": {"type": "string"},
          "origin": {"enum": ["score", "tension"]},
          "ceiling": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "코드가 채움"},
          "feasible": {"type": ["boolean", "null"], "description": "코드: ceiling ≥ target_adopt"}
        },
        "if": {"properties": {"deviates_from_engine": {"const": true}}},
        "then": {"required": ["deviation_reason"], "properties": {"deviation_reason": {"type": "string", "minLength": 5}}}
      }
    }
  }
}
