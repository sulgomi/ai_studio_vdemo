{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/whitespace/in.schema.json",
  "title": "whitespace payload",
  "type": "object",
  "required": ["target_segment_id", "segments", "need_labels", "research", "cells_top"],
  "additionalProperties": false,
  "properties": {
    "target_segment_id": {"type": "string"},
    "target_adopt": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.38},
    "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}}},
    "need_labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "research": {
      "type": "object",
      "required": ["trend", "competitor", "consumer"],
      "properties": {
        "trend": {"type": "array", "items": {"type": "object", "required": ["id", "title", "impl", "topic"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "impl": {"type": "string"}, "topic": {"type": "string"}, "strength": {"type": "number"}, "reliability": {"type": "number"}}}},
        "competitor": {"type": "object", "required": ["crowded", "empty", "nearest"], "properties": {"crowded": {"type": "array"}, "empty": {"type": "array"}, "nearest": {"type": "array"}}},
        "consumer": {"type": "object", "required": ["top_needs", "must_have", "can_give_up", "evidence_signal_ids"], "properties": {"top_needs": {"type": "array"}, "must_have": {"type": "array"}, "can_give_up": {"type": "array"}, "evidence_signal_ids": {"type": "array"}}},
        "lead": {"type": "object", "properties": {"headline": {"type": "string"}, "key_findings": {"type": "array"}, "conflicts": {"type": "array"}}}
      }
    },
    "cells_top": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "object", "required": ["seg", "need", "score", "rank"], "properties": {"seg": {"type": "string"}, "need": {"type": "string"}, "score": {"type": "number"}, "rank": {"type": "integer", "minimum": 1}, "ceiling": {"type": "number", "minimum": 0, "maximum": 1}}}
    },
    "tensions": {"type": "array", "items": {"type": "object", "required": ["topic", "positions"], "properties": {"topic": {"type": "string"}, "positions": {"type": "array"}}}},
    "excluded_cells": {"type": "array", "items": {"type": "object", "required": ["seg", "need", "reason"], "properties": {"seg": {"type": "string"}, "need": {"type": "string"}, "reason": {"type": "string"}}}}
  }
}
