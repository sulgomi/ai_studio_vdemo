{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/research_lead/out.schema.json",
  "title": "research_lead result",
  "type": "object",
  "required": [
    "headline",
    "answer_body",
    "key_findings",
    "evidence",
    "conflicts",
    "uncertainties",
    "opportunities",
    "risks",
    "recommendations",
    "calls"
  ],
  "additionalProperties": false,
  "properties": {
    "headline": {
      "type": "string",
      "maxLength": 120,
      "description": "한 줄 결론"
    },
    "answer_body": {
      "type": "string",
      "description": "결론 본문 3~5문장",
      "maxLength": 240
    },
    "key_findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/backed_claim"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/backed_claim"
          }
        ],
        "type": "object",
        "required": [
          "area"
        ],
        "properties": {
          "area": {
            "enum": [
              "trend",
              "competitor",
              "consumer",
              "own_card"
            ]
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic",
          "positions"
        ],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 240
          },
          "positions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "agent",
                "view"
              ],
              "additionalProperties": false,
              "properties": {
                "agent": {
                  "enum": [
                    "trend",
                    "competitor",
                    "consumer"
                  ]
                },
                "view": {
                  "type": "string",
                  "maxLength": 240
                },
                "basis": {
                  "type": "string",
                  "maxLength": 240
                },
                "limits": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          },
          "if_assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "description": "해석"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "description": "해석"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      },
      "description": "카드 기획 관점 제언(해석)"
    },
    "calls": {
      "type": "array",
      "description": "코드가 기록",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "question",
          "round",
          "ok"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "enum": [
              "trend",
              "competitor",
              "consumer"
            ]
          },
          "question": {
            "type": "string",
            "maxLength": 240
          },
          "depth": {
            "enum": [
              "overview",
              "detail"
            ]
          },
          "round": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 240
          },
          "ok": {
            "type": "boolean"
          },
          "rerouted_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "agent_outputs": {
      "type": "object",
      "description": "코드가 채움. 에이전트 id → request_id",
      "additionalProperties": {
        "type": "string",
        "maxLength": 240
      }
    },
    "verification": {
      "type": "object",
      "description": "코드가 채움(답 검증 집계)",
      "properties": {
        "supported": {
          "type": "integer"
        },
        "partial": {
          "type": "integer"
        },
        "unsupported": {
          "type": "integer"
        },
        "contradicted": {
          "type": "integer"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "report_markdown": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "backed_claim": {
      "type": "object",
      "required": [
        "claim",
        "finding_ids"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "maxLength": 240
        },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(trend|competitor|consumer)#[0-9]+$",
            "maxLength": 240
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "enum": [
              "trend",
              "competitor",
              "consumer"
            ]
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          },
          "description": "코드가 finding에서 옮김"
        }
      }
    }
  },
  "x-report-template": "../_common/report_templates.md"
}
