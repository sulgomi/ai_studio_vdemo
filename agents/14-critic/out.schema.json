{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/critic/out.schema.json",
  "title": "critic result",
  "type": "object",
  "required": [
    "lens",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "lens": {
      "type": "string"
    },
    "search_available": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "../../common/discovery.defs.schema.json#/$defs/check"
          }
        ],
        "type": "object",
        "required": [
          "subject_id",
          "grade"
        ],
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "grade": {
            "enum": [
              "강",
              "중",
              "약",
              "폐기",
              "A",
              "B",
              "C",
              "X"
            ],
            "description": "공백 후보는 강/중/약/폐기, 아이디어는 A/B/C/X"
          },
          "lens_fields": {
            "type": "object"
          }
        }
      }
    },
    "cross_notes": {
      "type": "string"
    }
  }
}