{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/critic/in.schema.json",
  "title": "critic payload",
  "type": "object",
  "required": [
    "lens",
    "subject_kind",
    "subjects",
    "evidence",
    "competitor_cards"
  ],
  "additionalProperties": false,
  "properties": {
    "lens": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "enum": [
            "existing",
            "evidence",
            "risk",
            "novelty"
          ]
        },
        "title": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "subject_kind": {
      "enum": [
        "gap_candidate",
        "idea"
      ]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "description": "근거 팩에서 코드가 고른 항목. 인용은 id 그대로",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "age_scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "stale": {
            "type": "boolean"
          }
        }
      }
    },
    "competitor_cards": {
      "type": "array",
      "description": "경쟁 카드 DB(공식 페이지 기준) 요약",
      "items": {
        "type": "object",
        "required": [
          "name",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "headline_benefits": {
            "type": "array"
          },
          "annual_fee_won": {
            "type": [
              "object",
              "null"
            ]
          },
          "min_prev_month_spend_won": {
            "type": [
              "integer",
              "null"
            ]
          },
          "on_sale": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          }
        }
      }
    },
    "search_available": {
      "type": "boolean"
    },
    "all_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "근거 색인 전체 id. payload.evidence 는 코드가 고른 일부이고, 인용 id 의 실재 검사는 이 전체 목록 기준이다"
    }
  }
}