{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/gap_analyst/out.schema.json",
  "title": "gap_analyst result",
  "type": "object",
  "required": [
    "angle",
    "candidates",
    "rejected"
  ],
  "additionalProperties": false,
  "properties": {
    "angle": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "../../common/discovery.defs.schema.json#/$defs/gap_candidate"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "idea",
          "why"
        ],
        "properties": {
          "idea": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}