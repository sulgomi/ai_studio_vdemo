{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/concept/out.schema.json",
  "title": "concept result",
  "type": "object",
  "required": [
    "options"
  ],
  "additionalProperties": false,
  "properties": {
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "working_title",
          "lever",
          "variation",
          "one_liner",
          "segId",
          "need",
          "hook",
          "special_point",
          "cvp",
          "tags",
          "rates",
          "capPerCat",
          "fee",
          "minPerf",
          "cx",
          "links",
          "mechanics",
          "evidence_ids",
          "assumptions",
          "hypotheses",
          "risks",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "working_title": {
            "type": "string",
            "description": "가칭(최종 이름 아님)"
          },
          "lever": {
            "enum": [
              "benefit_structure",
              "target_subsegment",
              "experience",
              "partnership"
            ]
          },
          "variation": {
            "type": "string"
          },
          "one_liner": {
            "type": "string",
            "description": "고객이 이해할 한 문장"
          },
          "segId": {
            "type": "string"
          },
          "need": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          },
          "special_point": {
            "type": "object",
            "required": [
              "hook",
              "why_unusual",
              "proof_mechanism",
              "not_like"
            ],
            "additionalProperties": false,
            "properties": {
              "hook": {
                "type": "string"
              },
              "why_unusual": {
                "type": "string"
              },
              "proof_mechanism": {
                "type": "string"
              },
              "not_like": {
                "type": "string"
              }
            }
          },
          "cvp": {
            "type": "object",
            "required": [
              "target",
              "need",
              "offer",
              "key_benefit",
              "alternative",
              "differentiator",
              "reason_to_believe"
            ],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string"
              },
              "need": {
                "type": "string"
              },
              "offer": {
                "type": "string"
              },
              "key_benefit": {
                "type": "string"
              },
              "alternative": {
                "type": "string"
              },
              "differentiator": {
                "type": "string"
              },
              "reason_to_believe": {
                "type": "string"
              }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rates": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.03
            }
          },
          "capPerCat": {
            "type": "number",
            "minimum": 0,
            "description": "카테고리별 월 한도(만원)"
          },
          "fee": {
            "type": "number",
            "minimum": 0,
            "description": "연회비(만원)"
          },
          "minPerf": {
            "type": "number",
            "minimum": 0,
            "description": "전월 실적 조건(만원). 없으면 0"
          },
          "cx": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "links": {
            "type": "array",
            "items": {
              "enum": [
                "sec",
                "ins",
                "bank"
              ]
            }
          },
          "mechanics": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "description": "T*, tag:*, need:*, ev:* 중 입력에 있는 id"
            }
          },
          "assumptions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "hypotheses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}