{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-studio/agents/concept/in.schema.json",
  "title": "concept payload",
  "type": "object",
  "required": ["pick", "segment_pack", "comp_empty", "comp_crowded", "consumer", "n_options"],
  "additionalProperties": false,
  "properties": {
    "pick": {
      "type": "object",
      "description": "whitespace.result.picks 중 H2에서 고른 것 그대로",
      "required": ["seg", "need", "rationale", "evidence_ids"],
      "properties": {"rank": {"type": "integer"}, "seg": {"type": "string"}, "need": {"type": "string"}, "rationale": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "risk": {"type": "string"}}
    },
    "segment_pack": {
      "type": "object",
      "required": ["allowed_tags", "categories", "constraints", "segment"],
      "properties": {
        "allowed_tags": {"type": "object", "additionalProperties": {"type": "string"}},
        "categories": {"type": "object", "description": "카테고리 키 → 라벨. 예: dining → 외식", "additionalProperties": {"type": "string"}},
        "constraints": {
          "type": "object",
          "required": ["max_rate", "max_cx", "fee_range"],
          "properties": {
            "max_rate": {"type": "number", "default": 0.03},
            "max_cx": {"type": "number", "default": 0.5},
            "fee_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "연회비 범위(만원)"},
            "links_allowed": {"type": "array", "items": {"enum": ["sec", "ins", "bank"]}}
          }
        },
        "segment": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "complexity_tolerance": {"type": "number"}, "need_weights": {"type": "object"}}}
      }
    },
    "comp_empty": {"type": "array", "items": {"type": "object", "required": ["tag"], "properties": {"tag": {"type": "string"}, "reason": {"type": "string"}}}},
    "comp_crowded": {"type": "array", "items": {"type": "object", "required": ["tag"], "properties": {"tag": {"type": "string"}, "reason": {"type": "string"}}}},
    "benchmarks": {
      "type": "array",
      "description": "코드가 경쟁 카드 혜택률을 혜택 유형군별로 집계",
      "items": {"type": "object", "required": ["mechanism_group", "unit", "low", "high", "median", "n"], "properties": {"mechanism_group": {"type": "string"}, "unit": {"enum": ["%", "원"]}, "low": {"type": "number"}, "high": {"type": "number"}, "median": {"type": "number"}, "n": {"type": "integer"}, "card_ids": {"type": "array", "items": {"type": "string"}}}}
    },
    "consumer": {"type": "object", "required": ["top_needs", "must_have", "can_give_up"], "properties": {"top_needs": {"type": "array"}, "must_have": {"type": "array", "items": {"type": "string"}}, "can_give_up": {"type": "array", "items": {"type": "string"}}}},
    "trend_refs": {"type": "array", "items": {"type": "object", "required": ["id", "title"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "impl": {"type": "string"}}}},
    "n_options": {"type": "integer", "const": 3},
    "feedback": {
      "type": ["object", "null"],
      "description": "재작업일 때",
      "properties": {
        "from": {"enum": ["eval", "validation", "guardrail", "human"]},
        "target_option": {"type": ["integer", "null"], "description": "특정 안만 고칠 때 index"},
        "guardrail_fixes": {"type": "array", "items": {"type": "object", "required": ["item", "suggestion"], "properties": {"item": {"type": "string"}, "suggestion": {"type": "string"}}}},
        "metrics": {"type": "object", "description": "미달 지표와 값. 예: {adopt: 0.31, topReject: inertia}"},
        "human_note": {"type": "string"}
      }
    }
  }
}
