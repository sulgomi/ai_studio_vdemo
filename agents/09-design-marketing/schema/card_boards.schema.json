{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "card_boards",
  "description": "One card concept: concept board + 3 variant mockups + 3 design-point boards. Content only; the renderer owns the look.",
  "type": "object",
  "required": [
    "brand",
    "target",
    "concept",
    "palette",
    "typography",
    "layout",
    "variants"
  ],
  "additionalProperties": false,
  "properties": {
    "brand": {
      "type": "object",
      "required": [
        "name",
        "card_type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 14,
          "description": "Invented brand name. Never a real issuer, network or company."
        },
        "card_type": {
          "type": "string",
          "enum": [
            "check",
            "credit",
            "prepaid",
            "membership"
          ]
        },
        "issuer_placeholder": {
          "type": "string",
          "default": "[ISSUER]"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "segment",
        "contexts"
      ],
      "additionalProperties": false,
      "properties": {
        "segment": {
          "type": "string",
          "maxLength": 40,
          "description": "One line, e.g. '20대 초반, 음악·페스티벌 문화'"
        },
        "contexts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 16
          },
          "description": "Everyday situations the card lives in. Feed the life_* video scenes."
        },
        "assumed": {
          "type": "boolean",
          "description": "true when inferred rather than given in the brief"
        }
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "tagline",
        "statement",
        "keywords"
      ],
      "additionalProperties": false,
      "properties": {
        "tagline": {
          "type": "string",
          "maxLength": 18
        },
        "statement": {
          "type": "string",
          "maxLength": 90,
          "description": "Two sentences at most."
        },
        "keywords": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 12
          },
          "description": "The last keyword is rendered highlighted."
        },
        "front_rule_note": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "hex",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 14
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "ground",
              "ink",
              "accent",
              "support",
              "metal"
            ]
          }
        }
      },
      "description": "Exactly one accent, exactly one ink, at least one ground."
    },
    "typography": {
      "type": "object",
      "required": [
        "display",
        "body",
        "mono"
      ],
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string",
          "enum": [
            "Unbounded",
            "Archivo Black",
            "Syne",
            "DM Serif Display",
            "Black Han Sans"
          ]
        },
        "body": {
          "type": "string",
          "enum": [
            "IBM Plex Sans KR",
            "Noto Sans KR",
            "Gothic A1",
            "Nanum Gothic"
          ]
        },
        "mono": {
          "type": "string",
          "enum": [
            "Space Mono",
            "JetBrains Mono",
            "IBM Plex Mono"
          ]
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "orientation",
        "orientation_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "description": "Decided by the agent from the concept (see system prompt: Card orientation)."
        },
        "front_shows": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "chip",
              "contactless",
              "logo",
              "type_label",
              "number"
            ]
          },
          "default": [
            "chip",
            "contactless",
            "logo",
            "type_label"
          ]
        },
        "orientation_reason": {
          "type": "string",
          "maxLength": 60,
          "description": "One line: why this orientation fits the concept. Shown to the customer."
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "material",
          "story"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9/]{1,11}$",
            "description": "Short uppercase name used in boards and video, e.g. HOLO"
          },
          "name": {
            "type": "string",
            "maxLength": 16,
            "description": "Korean display name, e.g. 홀로그램"
          },
          "material": {
            "type": "object",
            "required": [
              "preset"
            ],
            "additionalProperties": false,
            "properties": {
              "preset": {
                "type": "string",
                "enum": [
                  "holo",
                  "clear",
                  "metal",
                  "matte",
                  "gradient"
                ]
              },
              "tint": {
                "type": "string",
                "description": "Palette color name (clear tint / holo bias / matte color)"
              },
              "base": {
                "type": "string",
                "enum": [
                  "black",
                  "silver",
                  "gold"
                ],
                "description": "metal only"
              },
              "edge": {
                "type": "string",
                "description": "Palette color name for the card edge (metal) "
              },
              "stops": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "string"
                },
                "description": "gradient only: palette color names"
              },
              "chip": {
                "type": "string",
                "enum": [
                  "silver",
                  "gold",
                  "graphite"
                ]
              },
              "logo_color": {
                "type": "string",
                "description": "Palette color name for the logo"
              }
            }
          },
          "story": {
            "type": "object",
            "required": [
              "headline",
              "lead",
              "points",
              "persona",
              "mood"
            ],
            "additionalProperties": false,
            "properties": {
              "headline": {
                "type": "string",
                "maxLength": 18
              },
              "lead": {
                "type": "string",
                "maxLength": 80
              },
              "points": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "body",
                    "anchor"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "maxLength": 14
                    },
                    "body": {
                      "type": "string",
                      "maxLength": 70
                    },
                    "anchor": {
                      "type": "string",
                      "enum": [
                        "material",
                        "logo",
                        "chip",
                        "contactless",
                        "edge",
                        "front",
                        "back",
                        "type_label"
                      ]
                    }
                  }
                }
              },
              "persona": {
                "type": "string",
                "maxLength": 40
              },
              "mood": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "maxLength": 6
                }
              },
              "life_scene": {
                "type": "string",
                "maxLength": 40,
                "description": "The everyday scene this variant is shown in for the YouTube cut"
              }
            }
          }
        }
      }
    },
    "benefits": {
      "type": "array",
      "maxItems": 6,
      "description": "Only from the user's input. Never invented. Leave empty when none were given.",
      "items": {
        "type": "object",
        "required": [
          "category",
          "headline",
          "condition",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 16
          },
          "headline": {
            "type": "string",
            "maxLength": 24
          },
          "condition": {
            "type": "string",
            "maxLength": 60
          },
          "source": {
            "type": "string",
            "maxLength": 80
          },
          "variant": {
            "type": "string",
            "description": "Optional: variant code this benefit pairs with"
          }
        }
      }
    },
    "needs_compliance_review": {
      "type": "boolean"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "maxItems": 5
    }
  }
}